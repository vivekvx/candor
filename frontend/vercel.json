{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://your-railway-url.railway.app/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store"
        }
      ]
    }
  ]
}
